# ==============================================================================
# Autonomous Job Discovery & Application Command Center
# Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Operating Mode & Environment
# ------------------------------------------------------------------------------
# Supported APP_MODE values:
#   demo       - Fictional data, no external credentials, safe for contributors (DEFAULT)
#   personal   - Your private candidate profile, real SQLite DB, Gmail/AI integrations
#   production - Hosted deployment with strict API token authentication and CORS
APP_MODE=demo
NODE_ENV=development
PORT=3300
HOST=127.0.0.1

# Production Authentication & CORS (Required when APP_MODE=production)
# API_AUTH_TOKEN must be at least 32 characters in production mode
API_AUTH_TOKEN=
CORS_ORIGIN=
TRUST_PROXY=false

# ------------------------------------------------------------------------------
# 2. Persistence & File Paths
# ------------------------------------------------------------------------------
DATA_DIR=./data
DB_PATH=./data/job_platform.db
CUSTOM_RESUME_PATH=

# ------------------------------------------------------------------------------
# 3. Discovery & Submission Safety Gates
# ------------------------------------------------------------------------------
# Safe defaults: background cron and application sending are disabled by default.
HOURLY_DISCOVERY=false
APPLICATION_SUBMISSION_ENABLED=false
DAILY_TARGET_QUALIFIED=10
MIN_MATCH_SCORE=70

# ------------------------------------------------------------------------------
# 4. Local AI Inference (Ollama - 100% Private, Zero Cloud Cost)
# ------------------------------------------------------------------------------
OLLAMA_ENDPOINT=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_TIMEOUT_MS=60000

# ------------------------------------------------------------------------------
# 5. Cloud AI (Optional - Disabled by default for complete privacy)
# ------------------------------------------------------------------------------
CLOUD_DISABLED=true
CLOUD_PROVIDER=none
CLOUD_API_KEY=
CLOUD_BASE_URL=
CLOUD_MODEL=gpt-4o-mini
CLOUD_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# 6. Personal Google Workspace Integration (Gmail / Drive / Sheets)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3300/oauth2callback
GOOGLE_TOKEN_PATH=./data/google_tokens.json

# ------------------------------------------------------------------------------
# 7. Candidate Profile Defaults (Personal Mode)
# ------------------------------------------------------------------------------
USER_FULL_NAME=Alex Chen
USER_EMAIL=alex.chen.demo@example.com
USER_PHONE=+1-555-0199
USER_LOCATION=San Francisco, CA (Remote)
USER_PORTFOLIO_URL=https://alexchen.dev.example
USER_GITHUB_URL=https://github.com/example/alexchen
USER_LINKEDIN_URL=https://linkedin.com/in/example-alexchen
USER_BASE_COUNTRY=United States

# ------------------------------------------------------------------------------
# 8. Instant Mobile Alerts (Telegram / Discord)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
ALERTS_MIN_SCORE=85
