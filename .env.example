# Production AI Job Discovery & Application Automation Platform
NODE_ENV=development
PORT=3300
HOST=127.0.0.1

# Data Directory
DATA_DIR=./data
DB_PATH=./data/job_platform.db

# Local Ollama Inference (CPU/GPU)
OLLAMA_ENDPOINT=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_TIMEOUT_MS=60000

# Cloud LLM (Optional - Disabled by default for privacy & 0 cost)
CLOUD_DISABLED=true
CLOUD_PROVIDER=none
CLOUD_API_KEY=
CLOUD_BASE_URL=
CLOUD_MODEL=gpt-4o-mini
CLOUD_TIMEOUT_MS=30000

# Search & Automation Preferences
DAILY_TARGET_QUALIFIED=10
HOURLY_DISCOVERY=false
MIN_MATCH_SCORE=70

# Google Cloud OAuth 2.0 (Gmail / Drive / Sheets)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3300/oauth2callback
GOOGLE_TOKEN_PATH=./data/google_tokens.json
