[Unit]
Description=JOB DISCOVERY AI - Autonomous Platform Service
After=network.target

[Service]
Type=simple
# Replace with your system username and repository path
User=your_username
WorkingDirectory=/path/to/ai-job-discovery-platform
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=10
Environment=NODE_ENV=production
Environment=PORT=3300
Environment=HOST=127.0.0.1

# Security Hardening
ProtectSystem=full
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
